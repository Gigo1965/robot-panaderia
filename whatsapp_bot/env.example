# Copia este archivo a ".env" y completa con tus valores reales.
# Nunca subas el archivo ".env" real a ningún repositorio.

# --- Credenciales de Twilio (Console -> Account Info) ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Mientras se usa el Sandbox de pruebas, este es el número que Twilio
# te asigna (aparece en Console -> Messaging -> Try it out -> WhatsApp).
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --- IDs de las plantillas (se llenan DESPUES de correr setup_content_templates.py) ---
CONTENT_SID_MENU_PRINCIPAL=
CONTENT_SID_LISTA_PRODUCTOS=
CONTENT_SID_AGREGAR_MAS=
CONTENT_SID_CONFIRMAR_PEDIDO=
