# Variables del bot de WhatsApp (version 29-sep-2026).
# Van en el archivo .env de la RAIZ del proyecto (ROBOT PANADERO\.env), junto a las
# de Google Drive. Nunca subas el .env real a GitHub ni pegues sus valores en el chat.

# --- Credenciales de Twilio (Console -> Account Info) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Numero del Sandbox de WhatsApp de Twilio (Console -> Messaging -> Try it out -> WhatsApp),
# con el formato whatsapp:+1XXXXXXXXXX
TWILIO_WHATSAPP_FROM=

# Telefonos autorizados para el comando "ENTREGADO WA-xxx" (repartidor, administracion),
# separados por coma, con codigo de pais. Ejemplo de FORMATO (no son numeros reales):
#   BOT_NUMEROS_AUTORIZADOS=+50600000000,+50611111111
BOT_NUMEROS_AUTORIZADOS=

# Opcionales (si no se ponen, se usan estos valores):
# BOT_MINUTOS_INACTIVIDAD=30     pedido sin confirmar se borra tras 30 min sin mensajes
# BOT_MINUTOS_ENTREGA=25         tiempo estimado que se le dice al cliente
# BOT_VALIDAR_FIRMA=si           revisar que cada mensaje venga de Twilio

# OBSOLETO (29-sep-2026): ya no se usan plantillas (menus numerados).
# CONTENT_SID_MENU_PRINCIPAL=
# CONTENT_SID_LISTA_PRODUCTOS=
# CONTENT_SID_AGREGAR_MAS=
# CONTENT_SID_CONFIRMAR_PEDIDO=
