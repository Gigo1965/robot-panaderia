# ============================================================
# Plantilla de configuracion del ROBOT (conexion_drive + microservicios)
# 1) Copia este archivo y renombra la copia a:  .env
# 2) Llena los valores reales en .env  (el .env NUNCA se sube a GitHub)
# ============================================================

# De donde lee/escribe el robot el Excel maestro:
#   drive = el Excel real en Google Drive (uso normal)
#   local = una copia en tu PC (para pruebas, no toca Google Drive)
ORIGEN_EXCEL=drive

# ID del Excel maestro en Google Drive (la parte larga del enlace,
# entre /d/ y /edit)
EXCEL_MAESTRO_FILE_ID=pega_aqui_el_id_del_archivo

# Ruta al archivo de clave JSON de la Cuenta de Servicio (en tu PC)
GOOGLE_SERVICE_ACCOUNT_FILE=credenciales/clave-cuenta-servicio.json

# (Solo en la nube: GitHub Actions / Render) el CONTENIDO completo del JSON.
# En tu PC dejalo vacio y usa GOOGLE_SERVICE_ACCOUNT_FILE.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Solo si ORIGEN_EXCEL=local: ruta a la copia de prueba del Excel
EXCEL_LOCAL_PATH=datos_prueba/maestro_prueba.xlsx

# Recalcular formulas con LibreOffice antes de subir (si / no). Debe quedar en "si".
RECALCULAR=si

# Solo si LibreOffice no se encuentra solo. En Windows normalmente es:
# SOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.com
SOFFICE_PATH=

ZONA_HORARIA=America/Costa_Rica
